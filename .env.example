# Copy to .env and edit. All settings: src/concrete_rag/config.py (prefix CRAG_).

# --- LLM. fake = offline extractive mode (no LLM)
CRAG_LLM_PROVIDER=fake
# Local via Ollama:  CRAG_LLM_PROVIDER=openai_compat CRAG_LLM_BASE_URL=http://localhost:11434/v1 CRAG_LLM_MODEL=qwen2.5:14b-instruct
CRAG_LLM_MODEL=
CRAG_LLM_BASE_URL=
CRAG_LLM_API_KEY=

# --- Stores (empty = local: storage/docstore.db + embedded Qdrant in storage/qdrant)
CRAG_DOCSTORE_URL=
CRAG_QDRANT_URL=
CRAG_QDRANT_API_KEY=

# --- Models (local, sentence-transformers)
CRAG_EMBED_MODEL=BAAI/bge-m3
CRAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# --- API
CRAG_API_RATE_LIMIT=60/minute
CRAG_API_CORS_ORIGINS=
# dev only - a fixed admin key; leave empty in production and use `crag apikey create`
CRAG_API_BOOTSTRAP_ADMIN_KEY=
# For Qwen3 models on Ollama: CRAG_LLM_REASONING_EFFORT=none
